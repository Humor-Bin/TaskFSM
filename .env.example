DATABASE_URL=sqlite+pysqlite:///./taskfsm.db
TASKFSM_DEMO_SEED=1

# Observe Mode: read native Codex rollout sessions and refresh automatically.
CODEX_HOME=~/.codex
TASKFSM_CODEX_AUTO_SYNC=1
TASKFSM_CODEX_SYNC_INTERVAL=5
# A rollout with no file activity beyond this window is projected as ended.
TASKFSM_CODEX_ACTIVE_WINDOW=300

# Managed Mode is intentionally opt-in because it starts local codex processes.
TASKFSM_CODEX_MANAGED=0
TASKFSM_CODEX_COMMAND=codex
TASKFSM_BASE_URL=http://127.0.0.1:8000
